    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DeathKnight_Cursed"]/race</xpath>
    <value>
      <fleshType>BotchJob_UndeadFlesh</fleshType>
      <bloodDef>BotchJob_Filth_Undead</bloodDef>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DeathKnightChampion_Cursed"]/race</xpath>
    <value>
      <fleshType>BotchJob_UndeadFlesh</fleshType>
      <bloodDef>BotchJob_Filth_Undead</bloodDef>
    </value>
  </Operation>

</Patch>
