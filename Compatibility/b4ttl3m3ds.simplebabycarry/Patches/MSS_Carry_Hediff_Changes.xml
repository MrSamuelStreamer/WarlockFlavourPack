<?xml version="1.0" encoding="UTF-8" ?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/HediffDef[defName="SCB_Hediff_SoreFromCarrying"]/stages</xpath>
    <value>
      <stages>
			<li>
				<label>Conduit Strength</label>
			</li>
			<li>
				<minSeverity>0.1</minSeverity>
				<label>weak conduit</label>
				<painOffset>0.02</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.25</offset> <!-- offsets the initial hit but not fully-->
          </li>
        </capMods>
				<statFactors>
          <PsychicEntropyMax>0.8</PsychicEntropyMax>
          <PsychicEntropyRecoveryRate>0.95</PsychicEntropyRecoveryRate>
        </statFactors>
			</li>
			<li>
				<minSeverity>0.35</minSeverity>
				<label>established conduit</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.35</offset> <!-- cancels out the MSS_Debuffs negative -->
          </li>
        </capMods>
				<statFactors>
          <PsychicEntropyMax>1.65</PsychicEntropyMax>
          <PsychicEntropyRecoveryRate>1.25</PsychicEntropyRecoveryRate>
        </statFactors>
			</li>
			<li>
				<minSeverity>0.70</minSeverity>
				<label>empowered conduit</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.45</offset> <!-- +10% overall after a while -->
          </li>
        </capMods>
				<statFactors>
          <PsychicEntropyMax>2.6667</PsychicEntropyMax> <!-- Level 6 psylink level -->
          <PsychicEntropyRecoveryRate>1.625</PsychicEntropyRecoveryRate>
        </statFactors>
			</li>
		</stages>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/HediffDef[defName="SCB_Hediff_SoreFromCarrying"]/description</xpath>
    <value>
      <description>The link between the warlock and the child - the siphon and the conduit. By remaining in close contact, the conduit increases in strength overtime, not only stabilising both individuals, but eventually acting as a powerful boon.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/HediffDef[defName="SCB_Hediff_SoreFromCarrying"]/label</xpath>
    <value>
      <label>Conduit Strength</label>
    </value>
  </Operation>
</Patch>